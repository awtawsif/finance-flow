/**
 * @fileOverview Firestore Security Rules for FinanceFlow.
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model. Each user can only access their own data,
 * and no listing of all users is allowed.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.  Only the authenticated user can read or write their own profile.
 * - /users/{userId}/expenses/{expenseId}: Stores expense records. Only the owning user can manage their expenses.
 * - /users/{userId}/categories/{categoryId}: Stores expense categories. Only the owning user can manage their categories.
 * - /users/{userId}/budgets/{budgetId}: Stores budget information. Only the owning user can manage their budgets.
 *
 * Key Security Decisions:
 * - No global admin roles are defined.
 * - Listing all users is explicitly denied to protect user privacy.
 * - Data is structurally segregated, with user-specific data stored under the /users/{userId} path.
 *
 * Denormalization for Authorization:
 * - The data structure itself enforces authorization.  Expenses, Categories, and Budgets are all stored as subcollections
 *   under the user's document, allowing for path-based authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile if the userId matches their auth UID.
     * @allow (get) Authenticated user can read their own profile.
     * @allow (update) Authenticated user can update their own profile.
     * @allow (delete) Authenticated user can delete their own profile.
     * @deny (create) Non-authenticated user attempts to create a profile.
     * @deny (create) Authenticated user attempts to create a profile with a mismatched userId.
     * @deny (get) Another authenticated user attempts to read this user's profile.
     * @deny (update) Another authenticated user attempts to update this user's profile.
     * @deny (delete) Another authenticated user attempts to delete this user's profile.
     * @principle Enforces document ownership based on the path.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to expense documents under a specific user.
     * @path /users/{userId}/expenses/{expenseId}
     * @allow (create) Authenticated user can create an expense under their user ID.
     * @allow (get) Authenticated user can read an expense under their user ID.
     * @allow (update) Authenticated user can update an expense under their user ID.
     * @allow (delete) Authenticated user can delete an expense under their user ID.
     * @deny (create) Another authenticated user attempts to create an expense under this user's ID.
     * @deny (get) Another authenticated user attempts to read an expense under this user's ID.
     * @deny (update) Another authenticated user attempts to update an expense under this user's ID.
     * @deny (delete) Another authenticated user attempts to delete an expense under this user's ID.
     * @principle Enforces document ownership based on the path.
     */
    match /users/{userId}/expenses/{expenseId} {
        function isOwner(userId) {
          return request.auth.uid == userId;
        }
        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to category documents under a specific user.
     * @path /users/{userId}/categories/{categoryId}
     * @allow (create) Authenticated user can create a category under their user ID.
     * @allow (get) Authenticated user can read a category under their user ID.
     * @allow (update) Authenticated user can update a category under their user ID.
     * @allow (delete) Authenticated user can delete a category under their user ID.
     * @deny (create) Another authenticated user attempts to create a category under this user's ID.
     * @deny (get) Another authenticated user attempts to read a category under this user's ID.
     * @deny (update) Another authenticated user attempts to update a category under this user's ID.
     * @deny (delete) Another authenticated user attempts to delete a category under this user's ID.
     * @principle Enforces document ownership based on the path.
     */
    match /users/{userId}/categories/{categoryId} {
        function isOwner(userId) {
          return request.auth.uid == userId;
        }
        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to budget documents under a specific user.
     * @path /users/{userId}/budgets/{budgetId}
     * @allow (create) Authenticated user can create a budget under their user ID.
     * @allow (get) Authenticated user can read a budget under their user ID.
     * @allow (update) Authenticated user can update a budget under their user ID.
     * @allow (delete) Authenticated user can delete a budget under their user ID.
     * @deny (create) Another authenticated user attempts to create a budget under this user's ID.
     * @deny (get) Another authenticated user attempts to read a budget under this user's ID.
     * @deny (update) Another authenticated user attempts to update a budget under this user's ID.
     * @deny (delete) Another authenticated user attempts to delete a budget under this user's ID.
     * @principle Enforces document ownership based on the path.
     */
    match /users/{userId}/budgets/{budgetId} {
        function isOwner(userId) {
          return request.auth.uid == userId;
        }
        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }
  }
}